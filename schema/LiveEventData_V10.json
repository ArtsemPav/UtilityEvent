{
  "definitions": {
    "ConsecutiveWinsGoalConfig": {
      "type": "object",
      "required": [
        "WinsInStreakTarget",
        "NumberOfStreaksSpinPadGoal"
      ],
      "properties": {
        "WinsInStreakTarget": {
          "type": "integer"
        },
        "NumberOfStreaksSpinPadGoal": {
          "$ref": "#/definitions/MultiplierBasedValue"
        }
      }
    },
    "GoalConditions": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "MinWin": {
          "$ref": "#/definitions/ThresholdCondition"
        },
        "Threshold": {
          "$ref": "#/definitions/ThresholdCondition"
        }
      }
    },
    "ThresholdCondition": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "AvgBetBasedThreshold": {
          "$ref": "#/definitions/MultiplierBasedValue"
        },
        "FixedValue": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "MultiplierBasedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Multiplier",
        "Min",
        "Max"
      ],
      "properties": {
        "Multiplier": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "Min": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "Max": {
          "type": "integer",
          "exclusiveMinimum": 0
        }
      }
    },
